#!/bin/bash
#
# Build, sign, install, and launch Reflex.app from source.
#
# One-time setup (recommended): create a self-signed code-signing certificate
# named "Reflex Dev" in your login keychain so TCC Accessibility approval
# persists across rebuilds. If absent, this script falls back to ad-hoc
# signing and you will have to re-grant Accessibility every time you build.
#
#   1. Open Keychain Access.
#   2. Menu: Certificate Assistant -> Create a Certificate...
#   3. Name: Reflex Dev
#      Identity Type: Self Signed Root
#      Certificate Type: Code Signing
#      Check "Let me override defaults" and keep going (defaults are fine).
#      Keychain: login
#   4. After creation, double-click the cert -> Trust -> Code Signing: Always Trust.
#
# Then run ./save once, remove any old Reflex entries from System Settings ->
# Privacy & Security -> Accessibility, and re-grant Accessibility one final time.
# From then on, rebuilds will preserve the approval.

set -e

APP_NAME="Reflex"
BUNDLE_ID="com.reflex.app"
BUILD_DIR=".build/release"
APP_BUNDLE="$BUILD_DIR/$APP_NAME.app"
DEST="/Applications/$APP_NAME.app"

# Code-signing identity. Using a stable self-signed cert (instead of ad-hoc "-")
# keeps the code-signing identity constant across rebuilds, which lets TCC
# Accessibility approval persist instead of resetting every build.
# Falls back to ad-hoc if the cert is missing.
SIGN_IDENTITY="Reflex Dev"
# Check for the identity via plain `find-identity -v` (not `-p codesigning -v`):
# self-signed certs created via Keychain Access's Certificate Assistant often
# lack the strict code-signing extended key usage extension that the policy
# filter requires, but `codesign` itself accepts them just fine.
if ! security find-identity -v | grep -q "$SIGN_IDENTITY"; then
    echo "==> Code-signing identity '$SIGN_IDENTITY' not found in keychain; falling back to ad-hoc."
    echo "    (Accessibility approval will reset on every build until you create the cert.)"
    SIGN_IDENTITY="-"
fi

echo "==> Killing any running instances of $APP_NAME..."
killall "$APP_NAME" 2>/dev/null || true

echo "==> Building $APP_NAME in release mode..."
swift build --configuration release

echo "==> Creating app bundle..."
rm -rf "$APP_BUNDLE"
mkdir -p "$APP_BUNDLE/Contents/MacOS"
mkdir -p "$APP_BUNDLE/Contents/Resources"

# Copy executable
cp "$BUILD_DIR/$APP_NAME" "$APP_BUNDLE/Contents/MacOS/"

# Copy resources
if [ -d "$BUILD_DIR/${APP_NAME}_${APP_NAME}.bundle" ]; then
    cp -R "$BUILD_DIR/${APP_NAME}_${APP_NAME}.bundle/"* "$APP_BUNDLE/Contents/Resources/"
fi

# Create Info.plist with resolved variables
# IMPORTANT: must exist BEFORE codesign so the signature binds CFBundleIdentifier
# (otherwise codesign falls back to a content-hash identifier that changes every
# build, causing TCC/Accessibility approval to break across rebuilds).
cat > "$APP_BUNDLE/Contents/Info.plist" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Reflex</string>
    <key>CFBundleIdentifier</key>
    <string>com.reflex.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Reflex</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Reflex needs to send AppleScript commands to control media playback in your music apps.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2024. All rights reserved.</string>
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
        <string>x86_64</string>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
EOF

# Sign without entitlements — sandbox entitlements can interfere with TCC/Accessibility.
# Must run AFTER Info.plist is in place so the signature binds CFBundleIdentifier and the
# resulting code-signing identifier is stable as `com.reflex.app` across rebuilds.
codesign --force --sign "$SIGN_IDENTITY" "$APP_BUNDLE"

echo "==> Copying to Applications folder..."
rm -rf "$DEST"
cp -R "$APP_BUNDLE" "$DEST"

echo "==> Launching $APP_NAME..."
open "$DEST"

echo "==> Done! $APP_NAME is now running."
